{
  "name": "ghost-audit-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server/index.js",
  "description": "Ghost Audit — data breach audit & remediation dashboard prototype (Figma-faithful React implementation).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
